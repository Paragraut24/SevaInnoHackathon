{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets/|favicon.ico|manifest.webmanifest|icon.svg|sw.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}

