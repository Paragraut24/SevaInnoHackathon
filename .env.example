# Copy to .env (never commit .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Sightengine Free Tier (images & extracted video keyframes)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Optional Hugging Face Inference token for audio signal and private model download
HF_TOKEN=

# Optional V2 ONNX classifier repo on Hugging Face Hub (build-time download)
HF_MODEL_REPO=Parag28/sajag-scam-classifier
ML_ENABLED=true

# Comma-separated allowed browser origins
ALLOWED_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MIN=20

